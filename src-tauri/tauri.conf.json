{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tracker",
  "version": "0.1.0",
  "identifier": "com.tracker.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Tracker",
        "width": 1024,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "visible": true,
        "center": true
      },
      {
        "label": "popover",
        "title": "Tracker",
        "url": "popover.html",
        "width": 380,
        "height": 520,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": "default-src 'self' tauri:; img-src 'self' tauri: data: https:; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' tauri: ipc: http://ipc.localhost https://*.atlassian.net https://fonts.googleapis.com https://fonts.gstatic.com"
    }
  },
  "plugins": {
    "deep-link": {
      "schemes": ["tracker"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
