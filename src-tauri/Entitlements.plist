<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- WKWebView pod hardened runtime potřebuje JIT pro JavaScript. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Odchozí síť (Jira / Freelo / fonty). -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Focus mode řídí Safari a Chrome přes Apple Events (přepis URL
       blokovaného tabu). Bez tohoto entitlementu hardened runtime odmítne
       osascript ještě dřív, než se systém stihne zeptat na povolení. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
